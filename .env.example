# ============================================
# Tabe Football - Environment Variables
# Copy this to .env and fill in the values
# ============================================

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tabe_football
DB_USER=tabe_admin
DB_PASSWORD=CHANGE_ME

# Admin Auth (حداقل ۸ کاراکتر در production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX

# CORS — در production دامنه سایت را وارد کنید مثلاً: https://your-domain.com
CORS_ORIGIN=http://localhost:3000

# App
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
