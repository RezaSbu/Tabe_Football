# ============================================
# Tabe Football - Production Environment
# Copy this to .env on your VPS and fill in
# ============================================

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tabe_football
DB_USER=tabe_admin
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Admin Auth (حداقل ۸ کاراکتر!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX_HERE

# CORS — دامنه سایت خود را وارد کنید
CORS_ORIGIN=https://your-domain.com

# App
APP_URL=https://your-domain.com
PORT=3000
NODE_ENV=production
